# CreativeO Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# Email Service (Required for contact form and newsletter)
# Get your API key from: https://sendgrid.com/
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here

# Cloudflare Images (Optional - used for image optimization)
# Get these from: https://dash.cloudflare.com/
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here

# Development Environment (automatically set by Next.js)
NODE_ENV=development